# Ferry 的部署配置。复制为 deploy/.env 后填写;deploy/.env 里有密钥,不要提交、不要发给别人,另外找安全的地方备份。
# 完整的配置项见 apps/publisher/src/config.ts,这里只列部署必须填的和常用的。

# 镜像(在仓库根目录 docker build 出来的,或者从内部镜像仓库拉的)
FERRY_IMAGE=ferry:latest

# ---- 域名 ----
# Ferry 自己的地址(登录页、控制台、MCP、上传)。不要放在应用域名下面
FERRY_HOST=ferry.corp.example
# 浏览器和 agent 访问 Ferry 用的完整地址,上传地址、登录跳转、cookie 的 Secure 都按它来
PUBLIC_URL=https://ferry.corp.example
# 应用地址:<APPS_URL_SCHEME>://<应用名>.<APPS_DOMAIN>
APPS_DOMAIN=apps.corp.example
APPS_URL_SCHEME=https
# Ferry 走 Traefik 的哪个入口:有证书时 websecure + true;只有 http(本机测试)时 web + false
FERRY_ENTRYPOINT=websecure
FERRY_TLS=true

# ---- 密钥(都用 openssl rand -hex 32 生成)----
# Dokploy 管理页面 → 个人设置里生成的 API key
DOKPLOY_API_KEY=
# Ferry 自己的数据库密码
POSTGRES_PASSWORD=
# 登录网关签 cookie 用。换了之后所有人要重新登录一次
GATEWAY_SECRET=
# 加密应用密钥用。丢了或换了,员工保存过的应用密钥全部解不开:另外备份,不要换
SECRETS_KEY=

# ---- 人员 ----
# 组织架构文件在服务器上的路径(格式见 infra/dev-org.json),Ferry 定时重新读取
ORG_FILE_PATH=/opt/ferry/org.json
# 平台管理员的用户 ID(组织架构文件里的 id),逗号分隔
ADMIN_USERS=

# ---- 可选 ----
# 每人在线应用数上限、每个应用和数据库的资源上限(0 表示不限制)
# MAX_APPS_PER_USER=5
# APP_CPU_LIMIT=1
# APP_MEMORY_LIMIT_MB=512
# DB_CPU_LIMIT=1
# DB_MEMORY_LIMIT_MB=512
