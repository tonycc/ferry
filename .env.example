# 复制为 .env 后填写。.env 不会提交到 git;publisher 的 pnpm dev / start 启动时自动读取。
# 终端里已经设置的同名环境变量优先,不会被这里覆盖。完整配置项见 apps/publisher/src/config.ts。

# 本地 PostgreSQL(pnpm db:up 启动)。不设置时用内存存储,重启后数据丢失
# DATABASE_URL=postgres://ferry:ferry-dev@127.0.0.1:55432/ferry

# 本机 Dokploy(infra/dokploy/setup-local.sh 安装)。API key 在 Dokploy 管理页面的个人设置里生成
DOKPLOY_URL=http://localhost:3000
DOKPLOY_API_KEY=

# fake:全部用假实现;dokploy:对接本机 Dokploy,真实构建部署
# FERRY_PLATFORM=dokploy

# 对接本机 Dokploy 时:应用地址为 http://<应用名>.apps.localhost
# APPS_DOMAIN=apps.localhost
# APPS_URL_SCHEME=http

# 固定的平台管理员(用户 ID,逗号分隔,也接收告警),控制台上不能取消。可以不设:
# 第一个管理员用 pnpm set-password <手机号> --name <姓名> 建,其余在控制台“人员”页设置
# ADMIN_USERS=

# 每个应用和它的数据库的资源上限(默认 1 核、512 MB;0 表示不限制),每次发布时生效
# APP_CPU_LIMIT=1
# APP_MEMORY_LIMIT_MB=512
# DB_CPU_LIMIT=1
# DB_MEMORY_LIMIT_MB=512

# 发布前用 gitleaks 扫描密钥(brew install gitleaks)。off 跳过扫描,只用于临时试用
# SECRET_SCAN=off
# GITLEAKS_PATH=/opt/homebrew/bin/gitleaks

# 加密应用密钥(控制台上给应用配置的第三方 API key 等)用的密钥,至少 32 个字符。
# 用数据库时不设置就不能保存密钥;改了之后已保存的密钥都无法解密。生成:openssl rand -hex 32
# SECRETS_KEY=

# 给负责人的通知和给管理员的告警写进服务日志(一期没有对外发通知的渠道)
NOTIFY_VIA=log
# 开发用身份:为 true 时,没带凭据的请求可以用 x-ferry-user 请求头自称是谁。默认关闭
# DEV_AUTH=true
# agent 跑在 Docker 容器里时,上传地址要用容器能访问的地址(不要改 PUBLIC_URL,浏览器登录要用它)
# AGENT_URL=http://host.docker.internal:8081
# 用控制台开发服务器(pnpm dev:console)时,允许它用登录 cookie 发修改请求
# ALLOWED_ORIGINS=http://localhost:5173

# 登录网关:签网关 cookie 和健康检查口令的密钥(至少 32 个字符)。不设置时每次启动随机生成
# GATEWAY_SECRET=
# Traefik 访问 Ferry /authz 的地址,默认 http://host.docker.internal:<PORT>/authz(本机 Docker Desktop)
# GATEWAY_AUTH_URL=
